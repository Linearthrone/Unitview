{
  "name": "unitview-windows",
  "version": "5.4.1",
  "description": "Unitview Patient Management Dashboard - Windows Desktop Application",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd renderer && npm run build",
    "build:renderer:fast": "cd renderer && npm run build:no-check",
    "build:main": "tsc -p tsconfig.main.json",
    "build:all": "npm run build && electron-builder",
    "preview": "cd renderer && npm run preview",
    "electron": "electron dist/main.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:publish": "npm run build && electron-builder --win --publish always",
    "postinstall": "cd renderer && npm install",
    "prepare": "node scripts/install-git-hooks.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "npx --yes tsx --test src/security/*.test.ts src/fhir/*.test.ts src/ipc/*.test.ts src/wallpaper/*.test.ts src/updates/*.test.ts scripts/bump-version.test.mjs renderer/src/lib/vault-init.test.ts renderer/src/lib/wallpaper-snapshot.test.ts renderer/src/lib/safety-marks.test.ts renderer/src/lib/progressive-view.test.ts",
    "test:fresh": "git pull && npm install && cd renderer && npm install && cd .. && npm run build && npm run electron"
  },
  "keywords": [
    "healthcare",
    "patient-management",
    "hospital",
    "electron",
    "react"
  ],
  "author": "Linearthrone",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20",
    "baseline-browser-mapping": "^2.10.20",
    "concurrently": "^8.2.2",
    "electron": "^43.7.5",
    "electron-builder": "^26.8.1",
    "typescript": "^5"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.unitview.windows",
    "productName": "Unitview",
    "directories": {
      "output": "release"
    },
    "artifactName": "Unitview-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "renderer/dist/**/*",
      "renderer/package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Linearthrone",
      "repo": "Unitview",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    }
  }
}
