# =============================================================================
# Epic FHIR sandbox credentials — TEMPLATE (safe to commit)
# =============================================================================
# 1. Copy this file to:  .env.epic
# 2. Fill in values from your Epic App Orchard / sandbox developer account
# 3. Do NOT commit .env.epic (it is gitignored)
# 4. Tell the agent when .env.epic is ready — we wire live sync from it
#
# Never put secrets in the Electron renderer. These load in main/proxy only.
# =============================================================================

# --- Mode ---
# stub = demo data in-app (default today)
# live = real Epic FHIR calls (requires all fields below)
EPIC_AUTH_MODE=stub

# --- Endpoints (from Epic app "Endpoints" / Interconnect docs) ---
EPIC_FHIR_BASE_URL=
EPIC_TOKEN_URL=
EPIC_AUTHORIZE_URL=

# --- App identity ---
EPIC_CLIENT_ID=

# backend_services = JWT / private key (recommended for bed sync)
# smart_user      = user login SMART (optional later)
EPIC_CLIENT_AUTH=backend_services

# If using client secret (confidential client):
EPIC_CLIENT_SECRET=

# If using Backend Services JWT:
# Path to PEM private key file (preferred) OR paste PEM with \n escapes
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY=
EPIC_KEY_ID=

# --- Scopes (space-separated; match what Epic approved on your app) ---
# Minimum for bed → patient → allergies:
#   system/Location.read system/Encounter.read system/Patient.read system/AllergyIntolerance.read
EPIC_SCOPES=system/Location.read system/Encounter.read system/Patient.read system/AllergyIntolerance.read

# --- Bed matching (pilot unit) ---
# How Epic Location.name / identifier looks vs UnitView roomDesignation
# Examples: exact | strip_room_prefix | digits_only
EPIC_BED_MATCH_MODE=digits_only

# Optional: comma list of test beds that exist in sandbox (e.g. 812,814)
EPIC_SANDBOX_TEST_BEDS=

# Optional notes for the team (not used by code)
EPIC_SANDBOX_NOTES=
